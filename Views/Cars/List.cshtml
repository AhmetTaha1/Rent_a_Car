@model List<rent_a_car.Models.Car>

<section class="py-5">
    <div class="container">
        <h2 class="mb-4 text-center">Available Cars</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger text-center mb-4">@ViewBag.Error</div>
        }

        @* Arama filtre bilgileri *@
        @if (ViewBag.Error == null && (ViewBag.PickupDate != null || ViewBag.DropoffDate != null || ViewBag.SelectedCategory != null))
        {
            <div class="alert alert-light text-center mb-4 border shadow-sm">
                <strong>Search Filters:</strong>
                @if (ViewBag.PickupDate != null)
                {
                    <span>Pick-up: @ViewBag.PickupDate</span>
                }
                @if (ViewBag.DropoffDate != null)
                {
                    <span class="ms-2">Drop-off: @ViewBag.DropoffDate</span>
                }
                @if (!string.IsNullOrEmpty(ViewBag.SelectedCategory))
                {
                    <span class="ms-2">Category: @ViewBag.SelectedCategory</span>
                }
            </div>
        }

        @if (!Model.Any() && ViewBag.Error == null)
        {
            <p class="text-center text-muted">No cars available at the moment.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var car in Model)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow" style="cursor: default;">
                            <img src="@car.ImageUrl" class="card-img-top" alt="@car.Model"
                                style="height: 200px; object-fit: cover;" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@car.Model</h5>
                                <p class="text-muted mb-1"><strong>Category:</strong> @car.Category</p>
                                <p class="card-text flex-grow-1">@car.Description</p>
                                <p class="fw-bold fs-5 mt-2">$@car.PricePerDay.ToString("0.##")/day</p>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-center">
                                <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"
                                    asp-route-pickupDate="@ViewBag.PickupDate" asp-route-dropoffDate="@ViewBag.DropoffDate"
                                    class="btn btn-outline-primary w-100" style="cursor: pointer;">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
