@model rent_a_car.Models.Car
@{
    var similarCars = ViewBag.SimilarCars as List<rent_a_car.Models.Car>;
    var rating = 4.2;

    var today = DateTime.Today;
    var selectedMonth = today.Month;
    var selectedYear = today.Year;
    var isLoggedIn = Context.Session.GetString("UserId") != null;
}

<section class="py-5 bg-light min-vh-100">
    <div class="container">
        @if (TempData["ReservationError"] != null)
        {
            <div class="alert alert-danger">@TempData["ReservationError"]</div>
        }
        <!-- Car Details -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-10">
                <div class="row g-4 align-items-center bg-white rounded-4 shadow p-4">
                    <div class="col-md-5 text-center">
                        <img src="@Model.ImageUrl" alt="@Model.Model" class="img-fluid rounded-3 border border-1"
                            style="object-fit:contain; width:100%; max-width:400px; height:320px;" />
                    </div>
                    <div class="col-md-7">
                        <h2 class="fw-bold mb-2">@Model.Model</h2>
                        <div class="mb-2">
                            <span class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Floor(rating))
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else if (i - rating < 1)
                                    {
                                        <i class="fas fa-star-half-alt"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star"></i>
                                    }
                                }
                            </span>
                            <span class="ms-2 text-dark fw-semibold">@rating.ToString("0.0")</span>
                        </div>
                        <div class="mb-3 fs-3 fw-bold text-success">$@Model.PricePerDay.ToString("0.##") <span
                                class="fs-6 text-muted">/day</span></div>
                        <div class="mb-3">
                            <span class="badge bg-primary me-2">@Model.Category</span>
                            <span class="badge bg-success text-white border">@Model.Transmission </span>
                        </div>
                        <p class="text-muted mb-3">@Model.Description</p>
                        <div class="row g-2 small text-center">
                            <div class="col-6 col-md-3">
                                <div class="text-muted">Engine</div>
                                <div class="fw-semibold">@(Model.Engine ?? "1.6L")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted">Fuel</div>
                                <div class="fw-semibold">
                                    @if (Model.FuelType == "Electric") {
                                        <span>Electric</span>
                                    } else if (Model.FuelType == "Diesel") {
                                        <span>Diesel</span>
                                    } else {
                                        <span>Petrol</span>
                                    }
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted">Seats</div>
                                <div class="fw-semibold">@(Model.Seats ?? "5")</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-muted">Transmission</div>
                                <div class="fw-semibold">@(Model.Transmission ?? "Automatic")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Booking -->
        <div class="row justify-content-center mb-4">
            <div class="col-12 col-lg-10">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <div class="calendar-main-card rounded-4 p-4">
                            <div class="calendar-card mx-0" style="max-width: 100%;">
                                <div class="calendar-header w-100 mb-2">
                                    <select id="monthSelect" class="form-select form-select-sm w-auto">
                                        @foreach (var m in Enumerable.Range(1, 12))
                                        {
                                            <option value="@m" selected="@(m == selectedMonth)">@(new DateTime(selectedYear, m, 1).ToString("MMMM yyyy"))</option>
                                        }
                                    </select>
                                </div>
                                <div id="calendar" class="calendar"></div>
                                <div class="small text-muted mt-3">
                                    <span class="d-inline-block me-3"><span class="legend-box reserved-day d-inline-block me-1"></span>Dolu</span>
                                    <span class="d-inline-block"><span class="legend-box selected d-inline-block me-1"></span>Seçili</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="bg-white rounded-4 shadow p-4 h-100">
                            <h4 class="fw-bold mb-3">Rezervasyon Yap</h4>
                            @if (!isLoggedIn)
                            {
                                <div class="alert alert-warning">
                                    Rezervasyon yapabilmek için <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Cars", new { id = Model.Id })">giriş yapmalısınız</a>.
                                </div>
                            }
                            <form asp-controller="Cars" asp-action="Reserve" method="post">
                                <input type="hidden" name="carId" value="@Model.Id" />
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Teslim Alma</label>
                                    <input type="date" class="form-control" id="pickupInput" name="pickupDate"
                                        value="@ViewBag.PickupDate" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Bırakma</label>
                                    <input type="date" class="form-control" id="dropoffInput" name="dropoffDate"
                                        value="@ViewBag.DropoffDate" required />
                                </div>
                                <div class="mb-3 fs-5">
                                    Toplam: <span id="totalPrice" class="fw-bold text-success">-</span>
                                </div>
                                <button type="submit" class="btn btn-success fw-bold w-100" @(isLoggedIn ? "" : "disabled")>
                                    Rezervasyonu Onayla
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Similar Cars -->
        @if (similarCars != null && similarCars.Count > 0)
        {
            <div class="row justify-content-center mb-2">
                <div class="col-lg-10">
                    <h3 class="fw-bold mb-3">Similar Cars</h3>
                    <div class="row g-4">
                        @foreach (var car in similarCars)
                        {
                            <div class="col-md-4">
                                <div class="card h-100 shadow" style="cursor: default;">
                                    <img src="@car.ImageUrl" class="card-img-top" alt="@car.Model"
                                        style="height: 200px; object-fit: cover;" />
                                    <div class="card-body d-flex flex-column">
                                        <h5 class="card-title">@car.Model</h5>
                                        <p class="text-muted mb-1"><strong>Category:</strong> @car.Category</p>
                                        <p class="card-text flex-grow-1">@car.Description</p>
                                        <p class="fw-bold fs-5 mt-2">$@car.PricePerDay.ToString("0.##")/day</p>
                                    </div>
                                    <div class="card-footer bg-transparent border-0 text-center">
                                        <a asp-controller="Cars" asp-action="Details" asp-route-id="@car.Id"
                                            class="btn btn-outline-primary w-100" style="cursor: pointer;">
                                            View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .card {
        transition: box-shadow 0.2s, transform 0.2s;
    }

    .card:hover {
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.18) !important;
        transform: translateY(-4px) scale(1.03);
    }

    .calendar-main-card {
        min-height: 340px;
        height: 100%;
        box-shadow: 0 2px 16px rgba(0,0,0,0.07);
        background: #fff;
    }

    .calendar-card {
        background: #fff;
        border-radius: 18px;
        padding: 0;
        margin: 0 auto;
        min-height: 340px;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .calendar {
        width: 100%;
        margin: 0 auto;
        user-select: none;
    }

    .calendar .calendar-weekdays {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .calendar .calendar-weekdays div {
        flex: 1;
        text-align: center;
        font-weight: 600;
        color: #6c757d;
        font-size: 0.95rem;
    }

    .calendar-days {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .day-box {
        width: calc(14.28% - 6px);
        aspect-ratio: 1 / 1;
        border-radius: 10px;
        background: #f4f6fa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 500;
        font-size: 0.95rem;
        color: #222;
        cursor: pointer;
        transition: background 0.18s, color 0.18s, box-shadow 0.18s;
        border: 2px solid transparent;
        position: relative;
        z-index: 1;
    }

    .legend-box {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        vertical-align: middle;
    }
    .legend-box.reserved-day { background: repeating-linear-gradient(135deg, #f8d7da 0 5px, #f5c6cb 5px 10px); }
    .legend-box.selected { background: linear-gradient(135deg, #198754 60%, #43c97f 100%); }

    .day-box:hover:not(.reserved-day):not(.selected):not(.in-range):not(.empty-box):not(.past-day) {
        background: #e6f7ea;
        color: #198754;
        border-color: #b6e2c6;
    }

    .day-box.empty-box {
        background: transparent;
        cursor: default;
        border: none;
        box-shadow: none;
    }

    .day-box.past-day {
        color: #ccc;
        cursor: not-allowed;
    }

    .day-box.reserved-day {
        background: repeating-linear-gradient(135deg, #f8d7da 0 10px, #f5c6cb 10px 20px);
        color: #b71c1c;
        cursor: not-allowed;
        border: 2px solid #f5c6cb;
        opacity: 0.7;
    }

    .day-box.selected {
        background: linear-gradient(135deg, #198754 60%, #43c97f 100%);
        color: #fff;
        border: 2px solid #198754;
        z-index: 2;
        box-shadow: 0 2px 8px rgba(25,135,84,0.10);
    }

    .day-box.in-range {
        background: linear-gradient(135deg, #c6f3d6 60%, #e6f7ea 100%);
        color: #198754;
        border: 2px solid #b6e2c6;
        z-index: 1;
    }
</style>

@section Scripts {
    <script>
        (() => {
            const pricePerDay = @Model.PricePerDay.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const reservedRanges = @(Json.Serialize(ViewBag.ReservedRanges)).map(r => ({
                start: new Date(r.start),
                end: new Date(r.end)
            }));
            const calendar = document.getElementById('calendar');
            const monthSelect = document.getElementById('monthSelect');
            const pickupInput = document.getElementById('pickupInput');
            const dropoffInput = document.getElementById('dropoffInput');
            const totalPriceEl = document.getElementById('totalPrice');
            const todayMidnight = new Date(); todayMidnight.setHours(0,0,0,0);

            let startDate = pickupInput.value ? new Date(pickupInput.value + 'T00:00:00') : null;
            let endDate = dropoffInput.value ? new Date(dropoffInput.value + 'T00:00:00') : null;

            function isDateReserved(date) {
                return reservedRanges.some(range => date < range.end && addDays(date,1) > range.start);
            }
            function addDays(date, n) {
                const d = new Date(date);
                d.setDate(d.getDate() + n);
                return d;
            }
            function toIso(date) {
                return date.toISOString().split('T')[0];
            }
            function updateInputsAndTotal() {
                pickupInput.value = startDate ? toIso(startDate) : '';
                dropoffInput.value = endDate ? toIso(endDate) : '';
                if (startDate && endDate) {
                    const days = Math.round((endDate - startDate) / 86400000);
                    if (days > 0) {
                        totalPriceEl.textContent = '$' + (days * pricePerDay).toFixed(2) + ' (' + days + ' gün)';
                        return;
                    }
                }
                totalPriceEl.textContent = '-';
            }
            function renderCalendar(year, month) {
                calendar.innerHTML = '';
                const weekdays = ['Pz', 'Pt', 'Sa', 'Ça', 'Pe', 'Cu', 'Ct'];
                const weekdayRow = document.createElement('div');
                weekdayRow.className = 'calendar-weekdays';
                weekdays.forEach(wd => {
                    const wdBox = document.createElement('div');
                    wdBox.textContent = wd;
                    weekdayRow.appendChild(wdBox);
                });
                calendar.appendChild(weekdayRow);

                const firstDay = new Date(year, month - 1, 1);
                const daysInMonth = new Date(year, month, 0).getDate();
                const emptyBoxesCount = firstDay.getDay();
                const daysContainer = document.createElement('div');
                daysContainer.className = 'calendar-days';
                for (let i = 0; i < emptyBoxesCount; i++) {
                    const emptyBox = document.createElement('div');
                    emptyBox.className = 'day-box empty-box';
                    daysContainer.appendChild(emptyBox);
                }
                for (let day = 1; day <= daysInMonth; day++) {
                    const dayDate = new Date(year, month - 1, day);
                    const dayBox = document.createElement('div');
                    dayBox.className = 'day-box';
                    dayBox.textContent = day;
                    dayBox.setAttribute('data-date', toIso(dayDate));

                    if (dayDate < todayMidnight) {
                        dayBox.classList.add('past-day');
                    } else if (isDateReserved(dayDate)) {
                        dayBox.classList.add('reserved-day');
                    } else {
                        dayBox.addEventListener('click', () => {
                            if (startDate && !endDate) {
                                if (dayDate.getTime() <= startDate.getTime()) {
                                    startDate = dayDate;
                                    endDate = null;
                                } else if (hasReservedBetween(startDate, dayDate)) {
                                    // Aralıkta dolu gün varsa yeniden başlat
                                    startDate = dayDate;
                                    endDate = null;
                                } else {
                                    endDate = dayDate;
                                }
                            } else {
                                startDate = dayDate;
                                endDate = null;
                            }
                            updateInputsAndTotal();
                            updateSelection();
                        });
                    }
                    daysContainer.appendChild(dayBox);
                }
                calendar.appendChild(daysContainer);
                updateSelection();
            }
            function hasReservedBetween(start, end) {
                let d = addDays(start, 1);
                while (d < end) {
                    if (isDateReserved(d)) return true;
                    d = addDays(d, 1);
                }
                return false;
            }
            function updateSelection() {
                document.querySelectorAll('.day-box.selected, .day-box.in-range').forEach(el => {
                    el.classList.remove('selected', 'in-range');
                });
                if (!startDate) return;
                const dayBoxes = document.querySelectorAll('.day-box[data-date]');
                dayBoxes.forEach(box => {
                    const boxDate = new Date(box.getAttribute('data-date') + 'T00:00:00');
                    if (boxDate.getTime() === startDate.getTime()) {
                        box.classList.add('selected');
                    } else if (endDate && boxDate > startDate && boxDate < endDate) {
                        box.classList.add('in-range');
                    } else if (endDate && boxDate.getTime() === endDate.getTime()) {
                        box.classList.add('selected');
                    }
                });
            }
            renderCalendar(@selectedYear, @selectedMonth);
            updateInputsAndTotal();
            monthSelect.addEventListener('change', (e) => {
                const newMonth = parseInt(e.target.value);
                renderCalendar(@selectedYear, newMonth);
            });
            [pickupInput, dropoffInput].forEach(input => {
                input.addEventListener('change', () => {
                    startDate = pickupInput.value ? new Date(pickupInput.value + 'T00:00:00') : null;
                    endDate = dropoffInput.value ? new Date(dropoffInput.value + 'T00:00:00') : null;
                    updateInputsAndTotal();
                    updateSelection();
                });
            });
        })();
    </script>
}
