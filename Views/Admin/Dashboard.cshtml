@{
    ViewData["Title"] = "Admin Paneli";
}
<div class="container mt-5">
    <h2 class="mb-4 text-center fw-bold">Admin Panel</h2>
    <div class="row g-4 justify-content-center">
        <div class="col-md-4 col-12">
            <div class="admin-card text-center p-4 h-100">
                <div class="mb-3">
                    <i class="fas fa-car fa-2x text-primary"></i>
                </div>
                <a class="btn btn-outline-primary w-100 py-2 mb-2 fw-semibold" asp-action="CarList">Manage Vehicles</a>
                <div class="text-muted small">View, edit, or delete all vehicles</div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="admin-card text-center p-4 h-100">
                <div class="mb-3">
                    <i class="fas fa-users fa-2x text-primary"></i>
                </div>
                <a class="btn btn-outline-primary w-100 py-2 mb-2 fw-semibold" asp-action="UserList">Manage Users</a>
                <div class="text-muted small">Manage users and admin permissions</div>
            </div>
        </div>
        <div class="col-md-4 col-12">
            <div class="admin-card text-center p-4 h-100">
                <div class="mb-3">
                    <i class="fas fa-plus-circle fa-2x text-primary"></i>
                </div>
                <a class="btn btn-outline-primary w-100 py-2 mb-2 fw-semibold" asp-action="CarCreate">Add New Vehicle</a>
                <div class="text-muted small">Add a new vehicle to the system</div>
            </div>
        </div>
    </div>
</div>

<style>
    .admin-card {
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 4px 24px rgba(60,72,88,0.10);
        transition: box-shadow 0.2s, transform 0.2s;
        border: 1.5px solid #f3f3f3;
    }
    .admin-card:hover {
        box-shadow: 0 8px 32px rgba(0,123,255,0.13);
        transform: translateY(-4px) scale(1.03);
        border-color: #007bff22;
    }
    .admin-card i {
        margin-bottom: 0.5rem;
    }
    @@media (max-width: 768px) {
        .admin-card { padding: 1.2rem 0.5rem; }
    }
</style>
