@model rent_a_car.Models.Car
@{
    ViewData["Title"] = "Edit Car";
}

<h2 class="mb-4 text-center mt-5">Edit Car</h2>
<form asp-action="CarEdit" asp-controller="Admin" method="post" enctype="multipart/form-data" class="form-container">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3 text-center">
        <label class="form-label">Current Photo</label><br />
        <img src="@Model.ImageUrl" alt="Current Photo" style="max-width:220px; max-height:140px; object-fit:cover; border-radius:8px; border:1px solid #eee;" />
    </div>
    <div class="mb-3">
        <label class="form-label">Change Photo</label>
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Model" class="form-label">Model</label>
        <input asp-for="Model" class="form-control" required />
        <span asp-validation-for="Model" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label">Category</label>
        <select asp-for="Category" class="form-select" required>
            <option value="">Select Category</option>
            <option selected="@(Model.Category=="Economy")">Economy</option>
            <option selected="@(Model.Category=="Standard")">Standard</option>
            <option selected="@(Model.Category=="Luxury")">Luxury</option>
            <option selected="@(Model.Category=="SUV")">SUV</option>
            <option selected="@(Model.Category=="Convertible")">Convertible</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PricePerDay" class="form-label">Price Per Day</label>
        <input asp-for="PricePerDay" class="form-control" required />
        <span asp-validation-for="PricePerDay" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Transmission" class="form-label">Transmission</label>
        <select asp-for="Transmission" class="form-select">
            <option value="">Select Transmission</option>
            <option selected="@(Model.Transmission=="Automatic")">Automatic</option>
            <option selected="@(Model.Transmission=="Manual")">Manual</option>
        </select>
        <span asp-validation-for="Transmission" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Engine" class="form-label">Engine</label>
        <input asp-for="Engine" class="form-control" />
        <span asp-validation-for="Engine" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FuelType" class="form-label">Fuel Type</label>
        <select asp-for="FuelType" class="form-select" required>
            <option value="">Select Fuel Type</option>
            <option selected="@(Model.FuelType=="Petrol")">Petrol</option>
            <option selected="@(Model.FuelType=="Diesel")">Diesel</option>
            <option selected="@(Model.FuelType=="Electric")">Electric</option>
        </select>
        <span asp-validation-for="FuelType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Seats" class="form-label">Seats</label>
        <input asp-for="Seats" class="form-control" />
        <span asp-validation-for="Seats" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <button type="submit" class="btn btn-success">Save Changes</button>
        <a href="@Url.Action("CarList", "Admin")" class="btn btn-secondary">Cancel</a>
    </div>
</form>
<div class="d-flex justify-content-center mt-4">
    <form asp-action="CarDelete" asp-controller="Admin" method="post" style="display:inline;">
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-danger px-4 py-2" onclick="return confirm('Are you sure you want to delete this car?');">Delete Car</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
