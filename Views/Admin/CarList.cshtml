@model List<rent_a_car.Models.Car>

@if (TempData["CarDeleteInfo"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-4" role="alert" style="max-width:600px; margin:auto;">
        Car deleted successfully.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="py-5">
    <div class="container">
        <h2 class="mb-4 text-center">All Cars</h2>
        <a href="@Url.Action("CarCreate", "Admin")" class="btn btn-primary mb-3">Add New Car</a>

        @if (!Model.Any())
        {
            <p class="text-center text-muted">No cars available.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (var car in Model)
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow" style="cursor: default;">
                            <img src="@car.ImageUrl" class="card-img-top" alt="@car.Model" style="height: 200px; object-fit: cover;" />
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@car.Model</h5>
                                <p class="text-muted mb-1"><strong>Category:</strong> @car.Category</p>
                                <p class="card-text flex-grow-1">@car.Description</p>
                                <p class="fw-bold fs-5 mt-2">$@car.PricePerDay.ToString("0.##")/day</p>
                                <p class="mb-1"><strong>Fuel:</strong> @car.FuelType</p>
                                <p class="mb-1"><strong>Transmission:</strong> @car.Transmission</p>
                                <p class="mb-1"><strong>Engine:</strong> @car.Engine</p>
                                <p class="mb-1"><strong>Seats:</strong> @car.Seats</p>
                            </div>
                            <div class="card-footer bg-transparent border-0 text-center">
                                <a href="@Url.Action("CarEdit", "Admin", new { id = car.Id })" class="btn btn-outline-warning w-100">Edit</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>



