<div class="container vh-100 d-flex justify-content-center align-items-center">
    <div class="card shadow-sm p-4 log-card" style=" max-width: 450px; width: 100%;">
        <h3 class="text-center mb-4">Create Account</h3>
        <form method="post" asp-action="SignUp">
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <div class="mb-3">
                <label for="fullName" class="form-label fw-semibold text-dark">Full Name</label>
                <input type="text" class="form-control border border-secondary text-dark" id="fullName" name="FullName"
                    value="@ViewBag.FullName" placeholder="Your full name" required style="color: black;" />
            </div>
            <div class="mb-3">
                <label for="email" class="form-label fw-semibold text-dark">Email address</label>
                <input type="email" class="form-control border border-secondary text-dark" id="email" name="Email"
                    value="@ViewBag.Email" placeholder="name@example.com" required style="color: black;" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label fw-semibold text-dark">Password</label>
                <input type="password" class="form-control border border-secondary text-dark" id="password"
                    name="Password" placeholder="Create a password" required style="color: black;" />
            </div>
            <div class="mb-3">
                <label for="confirmPassword" class="form-label fw-semibold text-dark">Confirm Password</label>
                <input type="password" class="form-control border border-secondary text-dark" id="confirmPassword"
                    name="ConfirmPassword" placeholder="Confirm your password" required style="color: black;" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign Up</button>
        </form>
        <div class="text-center mt-3">
            <small class="text-dark">Already have an account? <a asp-controller="Account" asp-action="Login"
                    asp-route-returnUrl="@ViewBag.ReturnUrl">Sign In</a></small>
        </div>
    </div>
</div>
