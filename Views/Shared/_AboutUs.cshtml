<!-- About Us Section -->
<section class="py-5">
    <div class="container">
        <div class="card shadow border-0 overflow-hidden">
            <div class="row g-0">
                <!-- Image -->
                <div class="col-md-6">
                    <img src="img/mustang.jpeg" alt="About Royal Rent" class="img-fluid h-100 w-100 object-fit-cover" />
                </div>

                <!-- Text -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="p-4">
                        <h2 class="mb-3">About Royal Rent</h2>
                        <p>
                            At <strong>Royal Rent</strong>, we aim to redefine your car rental experience by
                            offering top-quality vehicles, personalized support, and unbeatable rates.
                        </p>
                        <p>
                            From economy to luxury vehicles, we cater to all travel needs with 24/7 support and
                            seamless booking.
                        </p>
                        <a asp-controller="Home" asp-action="About" class="btn btn-outline-primary mt-2">Learn More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
