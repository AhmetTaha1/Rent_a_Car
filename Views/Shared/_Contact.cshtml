<!-- Contact Section -->
<section id="contact" class="contact py-5">
    <div class="container">
        <div class="card shadow border-0 overflow-hidden">
            <div class="row g-0 align-items-stretch" style="min-height: 400px;"> <!-- Kısaltıldı -->

                <!-- Görsel -->
                <div class="col-md-6">
                    <div style="height: 100%; width: 100%;">
                        <img src="~/img/contact.jpeg" alt="Contact Us" class="img-fluid w-100 h-100"
                            style="object-fit: cover; object-position: center;" />
                    </div>
                </div>

                <!-- Form -->
                <div class="col-md-6 d-flex align-items-center">
                    <div class="px-4 py-3 w-100"> <!-- Daha az padding -->
                        <h2 class="mb-3 fs-3 fw-bold">Contact Us</h2> <!-- Daha küçük başlık -->
                        <form action="#" class="contact-form">
                            <div class="mb-2">
                                <label for="name" class="form-label fw-semibold">Name</label>
                                <input type="text" id="name" class="form-control border border-secondary"
                                    placeholder="Enter your name" required />
                            </div>
                            <div class="mb-2">
                                <label for="email" class="form-label fw-semibold">Email</label>
                                <input type="email" id="email" class="form-control border border-secondary"
                                    placeholder="Enter your email" required />
                            </div>
                            <div class="mb-2">
                                <label for="phone" class="form-label fw-semibold">Phone</label>
                                <input type="tel" id="phone" class="form-control border border-secondary"
                                    placeholder="Enter your phone number" />
                            </div>
                            <button type="submit" class="btn btn-outline-primary w-100 mt-3">Send</button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>
