<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>rent_a_car</RootNamespace>
    <!--
      Force invariant culture everywhere. Without this, decimal model binding (e.g. Car.PricePerDay)
      uses the server OS culture's number format. On a tr-TR machine that means '.' is treated as a
      thousands separator, so posting "199.5" silently binds to 1995 instead of 199.5. Forms in this
      app always submit '.'-decimal values (HTML number/text inputs), so invariant parsing is correct
      regardless of where the app is deployed.
    -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.6" />
  </ItemGroup>

</Project>
